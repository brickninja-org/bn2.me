{
  "name": "bn2.me",
  "private": true,
  "scripts": {
    "dev:web": "turbo run dev --filter=web",
    "dev:demo": "turbo run dev --filter=demo",
    "dev:emails": "turbo run dev --filter=@bn2me/emails",
    "prisma:studio": "pnpm run --filter @bn2me/database prisma:studio",
    "prisma:migrate-dev": "pnpm run --filter @bn2me/database prisma:migrate-dev",
    "build": "turbo run build",
    "lint": "turbo run lint --continue -- -f gha",
    "typecheck": "turbo run typecheck",
    "typecheck:web": "turbo run typecheck --filter=web",
    "typegen:web": "pnpm --filter web typegen",
    "test": "turbo run test",
    "publish-package": "turbo run publish-package",
    "postinstall": "pnpm typegen:web"
  },
  "devDependencies": {
    "dotenv": "17.2.3",
    "dotenv-cli": "10.0.0",
    "eslint-formatter-gha": "1.6.0",
    "turbo": "2.5.8",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "20 || >=22",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "pnpm": "10.18.2"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.7"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  },
  "packageManager": "pnpm@10.18.2"
}