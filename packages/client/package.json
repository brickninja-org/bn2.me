{
  "name": "@bn2me/client",
  "version": "0.3.0",
  "description": "bn2.me client library",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dpop": {
      "types": "./dist/dpop.d.ts",
      "default": "./dist/dpop.js"
    },
    "./pkce": {
      "types": "./dist/pkce.d.ts",
      "default": "./dist/pkce.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && if test $CI; then pnpm run build:ci; else pnpm run build:local; fi",
    "build:local": "tsup src/index.ts src/dpop.ts src/pkce.ts --format esm && tsc --emitDeclarationOnly --declaration --declarationMap",
    "build:ci": "tsup src/index.ts src/dpop.ts src/pkce.ts --format esm --minify --dts",
    "clean": "rm -rf dist/",
    "lint": "eslint src",
    "publish-package": "brickninja-publish-package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brickninja-org/bn2.me.git"
  },
  "keywords": [
    "bn2me",
    "bn2",
    "lego",
    "auth",
    "oauth2"
  ],
  "files": [
    "dist/"
  ],
  "author": "@brickninja",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/brickninja-org/bn2.me/issues"
  },
  "homepage": "https://github.com/brickninja-org/bn2.me#readme",
  "devDependencies": {
    "@brickninja-org/eslint-config": "0.1.1",
    "@brickninja-org/publish-package": "0.0.1-rc.0",
    "@brickninja-org/tsconfig": "0.0.2",
    "eslint": "9.36.0",
    "tsup": "8.5.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "undici-types": "7.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
