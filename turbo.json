{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "VERCEL_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [ "^build"],
      "env": [
        "POSTGRES_URL",
        "PRISMA_DATABASE_URL",
        "DATABASE_URL",
        "DEMO_CLIENT_ID",
        "DEMO_CLIENT_SECRET"
      ]
    },
    "start": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "env": [
        "GITHUB_ACTIONS"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "prisma:generate": {
      "cache": false
    },
    "prisma:migrate": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ]
    },
    "publish-package": {
      "cache": false,
      "dependsOn": [
        "build"
      ],
      "env": [
        "GITHUB_EVENT_NAME",
        "GITHUB_OUTPUT",
        "NODE_AUTH_TOKEN",
        "NPM_CONFIG_*"
      ]
    }
  }
}