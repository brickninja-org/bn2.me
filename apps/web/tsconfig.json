{
  "extends": "@brickninja-org/tsconfig/nextjs",
  "compilerOptions": {
    // TODO: remove verbatimModuleSyntax override
    "verbatimModuleSyntax": false,

    "baseUrl": "./",
    "paths": {
      "@/components/*": ["components/*"],
      "@/lib/*": ["lib/*"],
      "@/styles/*": ["styles/*"],
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    ".next/types/**/*.ts"
  ],
}