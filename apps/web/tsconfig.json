{
  "extends": "@brickninja-org/tsconfig/nextjs",
  "compilerOptions": {
    // TODO: remove verbatimModuleSyntax override
    "verbatimModuleSyntax": false,

    "baseUrl": ".",
    "jsx": "preserve",
    "paths": {
      "@/.source": ["./.source/index.ts"],
      "@/*": ["./src/*"],
      "~env": ["./env.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/.well-known/**/*.ts",
    ".next/types/**/*.ts",
    "postcss.config.mjs",
    "vitest.config.mts"
  ]
}