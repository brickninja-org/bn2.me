{
  "$schema": "https://turbo.build/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "build": {
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".source/**",
        "dist/**"
      ]
    },
    "dev": {
      "persistent": true,
      "dependsOn": [
        "^build",
        "@bn2me/database#prisma:migrate"
      ]
    },
    "typecheck": {
      "dependsOn": ["@bn2me/database#prisma:migrate"],
      "outputs": []
    }
  }
}